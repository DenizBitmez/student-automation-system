@using StudentManagementFrontend.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <div class="container mt-5">
                            <div class="row justify-content-center">
                                <div class="col-md-6">
                                    <div class="card border-danger shadow-sm">
                                        <div class="card-body text-center p-5">
                                            <div class="display-1 text-danger mb-3">
                                                <i class="bi bi-shield-lock"></i>
                                            </div>
                                            <h2 class="mb-3 text-danger">Erişim Reddedildi</h2>
                                            <p class="text-muted mb-4">Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.</p>
                                            <a href="/" class="btn btn-outline-danger">
                                                <i class="bi bi-house me-2"></i>
                                                Ana Sayfaya Dön
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </LayoutView>
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center p-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yetki kontrolü yapılıyor...</span>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h1 class="display-1 text-muted">404</h1>
                                    <h2 class="mb-3">Sayfa Bulunamadı</h2>
                                    <p class="text-muted mb-4">Aradığınız sayfa mevcut değil veya taşınmış olabilir.</p>
                                    <a href="/" class="btn btn-primary">
                                        <i class="bi bi-house me-2"></i>
                                        Ana Sayfaya Dön
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>